<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>BarEscola</display-name>

  <!-- ===================== JSF (backoffice) ===================== -->
  <context-param>
    <param-name>jakarta.faces.PROJECT_STAGE</param-name>
    <param-value>Development</param-value>
  </context-param>
  <servlet>
    <servlet-name>FacesServlet</servlet-name>
    <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>FacesServlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>

  <!-- ===================== JAX-RS ===================== -->
  <!-- Ativa @RolesAllowed nos recursos REST -->
  <context-param>
    <param-name>resteasy.role.based.security</param-name>
    <param-value>true</param-value>
  </context-param>

  <!-- ===================== Sessão ===================== -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- Em produção (HTTPS) ativar: <secure>true</secure> -->
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

  <!-- ===================== Segurança (etapa 10) ===================== -->

  <!-- Públicos: estado da API (etapa 1) e criação de conta -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Publico</web-resource-name>
      <url-pattern>/api/estado</url-pattern>
      <url-pattern>/api/registo</url-pattern>
    </web-resource-collection>
  </security-constraint>

  <!-- Aluno -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Aluno</web-resource-name>
      <url-pattern>/aluno/*</url-pattern>
      <url-pattern>/menu</url-pattern>
      <url-pattern>/carrinho</url-pattern>
      <url-pattern>/encomendar</url-pattern>
      <url-pattern>/ws/aluno</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>ALUNO</role-name>
    </auth-constraint>
  </security-constraint>

  <!-- Balcão -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Balcao</web-resource-name>
      <url-pattern>/balcao/*</url-pattern>
      <url-pattern>/ws/balcao</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>FUNCIONARIO</role-name>
      <role-name>GESTOR</role-name>
    </auth-constraint>
  </security-constraint>

  <!-- Backoffice -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Backoffice</web-resource-name>
      <url-pattern>/backoffice/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>GESTOR</role-name>
    </auth-constraint>
  </security-constraint>

  <!-- API e páginas comuns: qualquer utilizador autenticado (o papel fino é verificado com @RolesAllowed) -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>Autenticado</web-resource-name>
      <url-pattern>/api/*</url-pattern>
      <url-pattern>/inicio</url-pattern>
      <url-pattern>/logout</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>ALUNO</role-name>
      <role-name>FUNCIONARIO</role-name>
      <role-name>GESTOR</role-name>
    </auth-constraint>
  </security-constraint>

  <login-config>
    <auth-method>FORM</auth-method>
    <realm-name>ApplicationRealm</realm-name>
    <form-login-config>
      <form-login-page>/login.html</form-login-page>
      <form-error-page>/login.html?erro=1</form-error-page>
    </form-login-config>
  </login-config>

  <security-role><role-name>ALUNO</role-name></security-role>
  <security-role><role-name>FUNCIONARIO</role-name></security-role>
  <security-role><role-name>GESTOR</role-name></security-role>

  <error-page>
    <error-code>403</error-code>
    <location>/erro/403.html</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/erro/404.html</location>
  </error-page>
</web-app>
